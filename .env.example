# --- Database ---------------------------------------------------------------
# SQLite is the zero-config default for local use. For production, point this
# at Postgres (see README) and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- App ---------------------------------------------------------------------
# Used for "today", month boundaries, and bill projections.
APP_TIMEZONE="America/Toronto"

# --- Plaid bank sync (optional) ----------------------------------------------
# Create an app in the Plaid dashboard, then copy its client ID and secret.
# PLAID_ENV can be sandbox, development, or production.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="production"

# Encrypts Plaid access tokens at rest. Generate once with:
#   openssl rand -base64 32
# Keep this value backed up with the database; changing it makes existing
# connections unreadable until they are linked again.
PLAID_TOKEN_ENCRYPTION_KEY=""

# Optional: Plaid does not currently use OAuth for Canadian institutions.
# If OAuth is enabled for a bank later, add the exact URL to Dashboard → Team →
# API → Allowed redirect URIs. It must not include query parameters.
# Example: https://loonie.example.com/connections
PLAID_REDIRECT_URI=""

# Optional: public URL for transaction webhooks. Add this exact URL in Plaid
# (Link tokens will register it automatically). Example:
# https://loonie.example.com/api/plaid/webhook
PLAID_WEBHOOK_URL=""

# Optional guardrail matching your Plaid plan. Defaults to 10.
PLAID_MAX_ITEMS="10"
